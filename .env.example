# Copy this file to .env and paste your Binance DEMO API key and secret.
# Create them at https://demo.binance.com/en/my/settings/api-management
BINANCE_API_KEY=paste-your-demo-api-key-here
BINANCE_API_SECRET=paste-your-demo-secret-key-here

# Demo only. The app refuses any other host.
BINANCE_BASE_URL=https://demo-api.binance.com

SYMBOL=BTCUSDT
BASE=BTC
QUOTE=USDT

# Optional: where the SQLite journal is stored. Defaults to ./journal.db
# (Docker Compose sets this to /data/journal.db on a persistent volume.)
# JOURNAL_PATH=journal.db
